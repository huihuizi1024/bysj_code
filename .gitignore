### ========================================== ###
###        全局与系统环境屏蔽 (Global)           ###
### ========================================== ###

# Mac/Windows 系统生成的隐藏文件
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# 开发工具配置 (防止不同电脑和IDE之间产生路径冲突)
.idea/
.vscode/
**/*.iml
**/*.iws
**/*.ipr
*.sublime-workspace

# 通用日志和临时文件
*.log
*.tmp
*.bak
*.swp
./docs

### ========================================== ###
###       1. Java 后端 (1_java_backend)        ###
### ========================================== ###

# 编译输出目录
**/target/
**/out/
**/gen/
*.class

#敏感配置文件（密钥/API Key/数据库密码）
1_java_backend/secrets.properties

# Maven Wrapper（每次运行自动生成）
1_java_backend/.mvn/

# 打包文件 (体积较大，不需要版本控制)
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Java 虚拟机崩溃日志
hs_err_pid*
replay_pid*


### ========================================== ###
###       2. Vue 前端 (2_vue_frontend)         ###
### ========================================== ###

# 依赖包目录 (必须屏蔽，否则仓库会直接卡死)
**/node_modules/

# 编译打包的最终产物
**/dist/
**/dist-ssr/

# 本地环境变量 (防止 API Key、数据库密码等敏感信息泄露)
**/.env.local
**/.env.*.local

# 包管理器错误日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


### ========================================== ###
###      3. AI 引擎 (3_ai_engine / Python)     ###
### ========================================== ###

# Python 第三方库打包目录（不应纳入版本控制）
pylibs/
# Python 虚拟环境及编译缓存
**/venv/
**/.venv/
**/env/
**/__pycache__/
**/*.py[cod]
**/*.pyd

# AI 模型权重与检查点 (体积巨大，坚决隔离，走物理传输)
**/saves/
**/*.ckpt
**/*.safetensors
**/*.pth
**/*.pt
**/*.bin
**/*.onnx
**/*.h5

# LLaMA-Factory 缓存及数据集处理缓存
**/llamaboard_cache/
**/data/cache/

# Jupyter Notebook 缓存
**/.ipynb_checkpoints/
**/.pytest_cache/

# 忽略 AI 训练用的超大原始数据集 (保护前端 package.json 不被误伤)
**/LLaMA-Factory/data/*.json
**/PsyQA_train.json
/.cursor
